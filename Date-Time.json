      "parameters": {
        "jsCode": "// input example: \"IN\" or \"US\"\nconst countryCode = String(\n  $input.first().json.query.countery || ''\n).toUpperCase();\n\n// country → timezone map\nconst countryToTimezone = {\n  // Asia\n  IN: 'Asia/Kolkata',\n  PK: 'Asia/Karachi',\n  BD: 'Asia/Dhaka',\n  NP: 'Asia/Kathmandu',\n  LK: 'Asia/Colombo',\n  CN: 'Asia/Shanghai',\n  JP: 'Asia/Tokyo',\n  KR: 'Asia/Seoul',\n  TH: 'Asia/Bangkok',\n  SG: 'Asia/Singapore',\n  MY: 'Asia/Kuala_Lumpur',\n  ID: 'Asia/Jakarta',\n  PH: 'Asia/Manila',\n  VN: 'Asia/Ho_Chi_Minh',\n  AE: 'Asia/Dubai',\n  SA: 'Asia/Riyadh',\n  IL: 'Asia/Jerusalem',\n  IR: 'Asia/Tehran',\n  IQ: 'Asia/Baghdad',\n  AF: 'Asia/Kabul',\n\n  // Europe\n  UK: 'Europe/London',\n  FR: 'Europe/Paris',\n  DE: 'Europe/Berlin',\n  IT: 'Europe/Rome',\n  ES: 'Europe/Madrid',\n  PT: 'Europe/Lisbon',\n  NL: 'Europe/Amsterdam',\n  BE: 'Europe/Brussels',\n  CH: 'Europe/Zurich',\n  AT: 'Europe/Vienna',\n  SE: 'Europe/Stockholm',\n  NO: 'Europe/Oslo',\n  DK: 'Europe/Copenhagen',\n  FI: 'Europe/Helsinki',\n  PL: 'Europe/Warsaw',\n  CZ: 'Europe/Prague',\n  HU: 'Europe/Budapest',\n  RO: 'Europe/Bucharest',\n  GR: 'Europe/Athens',\n  RU: 'Europe/Moscow',\n  UA: 'Europe/Kyiv',\n\n  // North America\n  US: 'America/New_York',\n  CA: 'America/Toronto',\n  MX: 'America/Mexico_City',\n\n  // South America\n  BR: 'America/Sao_Paulo',\n  AR: 'America/Argentina/Buenos_Aires',\n  CL: 'America/Santiago',\n  CO: 'America/Bogota',\n  PE: 'America/Lima',\n  VE: 'America/Caracas',\n\n  // Africa\n  ZA: 'Africa/Johannesburg',\n  EG: 'Africa/Cairo',\n  NG: 'Africa/Lagos',\n  KE: 'Africa/Nairobi',\n  GH: 'Africa/Accra',\n  MA: 'Africa/Casablanca',\n  TZ: 'Africa/Dar_es_Salaam',\n\n  // Oceania\n  AU: 'Australia/Sydney',\n  NZ: 'Pacific/Auckland',\n  FJ: 'Pacific/Fiji'\n};\n\nif($input.first().json.query.countery in countryToTimezone){\n  const timezone = countryToTimezone[countryCode] || 'IN';\n\n  const now = new Date();\n\n  const formatter = new Intl.DateTimeFormat('en-US', {\n      timeZone: timezone,\n      year: 'numeric',\n      month: '2-digit',\n      day: '2-digit',\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n      hour12: true\n    });\n    \n    return [\n      {\n        json: {\n          status: true,\n          country: countryCode,\n          timezone,\n          currentTime: formatter.format(now)\n        }\n      }\n    ];\n} else {\n  return [{json: {status: false}}]\n}\n\n// safe lookup with fallback\n\n"
      },
